{
  "name": "fuel-tracker",
  "version": "2.8.0",
  "description": "PWA aplikace pro sledování spotřeby paliva s pokročilým error handlingem a logováním",
  "main": "index.html",
  "scripts": {
    "dev": "python -m http.server 8000",
    "test": "node tests/run-tests.js",
    "deploy": "wrangler pages deploy .",
    "deploy:production": "wrangler pages deploy . --branch=main"
  },
  "keywords": [
    "pwa",
    "fuel-tracker",
    "vehicle",
    "fuel-consumption",
    "offline-first"
  ],
  "author": "Tomas Patloka",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tomaspatloka/my-fuel-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/tomaspatloka/my-fuel-tracker/issues"
  },
  "homepage": "https://github.com/tomaspatloka/my-fuel-tracker#readme"
}
